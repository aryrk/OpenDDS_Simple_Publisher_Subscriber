module ObjectTrackData {
    @topic
    struct Message {
        unsigned short sourceId;
        string sourceName;
        unsigned short trackId;
        string sensorTrackId;
        @optional double latitude;
        @optional double longitude;
        @optional double bearing;
        @optional double range;
        @optional double altitude;
        @optional double course;
        @optional double speed;
        @optional double verticalSpeed;
        long long time;
    };
};